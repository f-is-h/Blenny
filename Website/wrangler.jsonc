{
  // Blenny website: a static site served by Cloudflare Workers static assets.
  // Deploy from this directory with `npx wrangler deploy`.
  "name": "blenny-website",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // The app's Website menu item already opens this address. It is the only
  // address: no workers.dev or preview URLs, so search engines see one site.
  "routes": [{ "pattern": "blenny.fi5h.xyz", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
